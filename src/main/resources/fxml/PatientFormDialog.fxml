<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinicdesk.ui.controller.PatientFormDialogController"
      spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-padding: 24px;"
      stylesheets="@../css/styles.css" prefWidth="560.0">

    <!-- Dialog Header -->
    <VBox spacing="4.0">
        <Label fx:id="dialogTitle" text="Register New Patient" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Label text="Enter patient personal and demographic details below." style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
    </VBox>

    <!-- Error Banner -->
    <Label fx:id="formErrorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

    <!-- Form Grid -->
    <GridPane hgap="14.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0"/>
            <ColumnConstraints percentWidth="50.0"/>
        </columnConstraints>

        <!-- Full Name -->
        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Full Name *" styleClass="field-label"/>
            <TextField fx:id="fullNameField" promptText="e.g. John Doe"/>
        </VBox>

        <!-- Date of Birth -->
        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Date of Birth *" styleClass="field-label"/>
            <DatePicker fx:id="dobPicker" promptText="YYYY-MM-DD" maxWidth="Infinity"/>
        </VBox>

        <!-- Gender -->
        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Gender" styleClass="field-label"/>
            <ComboBox fx:id="genderComboBox" promptText="Select Gender" maxWidth="Infinity"/>
        </VBox>

        <!-- Phone -->
        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Phone Number *" styleClass="field-label"/>
            <TextField fx:id="phoneField" promptText="+1 234 567 8900"/>
        </VBox>

        <!-- Email -->
        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Email Address" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="patient@example.com"/>
        </VBox>

        <!-- Blood Group -->
        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Blood Group" styleClass="field-label"/>
            <ComboBox fx:id="bloodGroupComboBox" promptText="Select Blood Group" maxWidth="Infinity"/>
        </VBox>

        <!-- Emergency Contact -->
        <VBox spacing="4.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
            <Label text="Emergency Contact Name &amp; Phone" styleClass="field-label"/>
            <TextField fx:id="emergencyContactField" promptText="e.g. Jane Doe (+1 987 654 3210)"/>
        </VBox>

        <!-- Allergies -->
        <VBox spacing="4.0" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label text="Known Allergies (if any)" styleClass="field-label"/>
            <TextArea fx:id="allergiesArea" promptText="e.g. Penicillin, Peanuts, Latex..." prefRowCount="2" wrapText="true"/>
        </VBox>

        <!-- Address -->
        <VBox spacing="4.0" GridPane.columnSpan="2" GridPane.rowIndex="5">
            <Label text="Residential Address" styleClass="field-label"/>
            <TextArea fx:id="addressArea" promptText="Street, City, Postal Code..." prefRowCount="2" wrapText="true"/>
        </VBox>
    </GridPane>

    <!-- Dialog Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 8px 0 0 0;">
        <Button text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button fx:id="saveButton" text="Save Patient" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
